# Generate a private .env with: python scripts/setup.py
SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_USER=surfacewatch
POSTGRES_DB=surfacewatch
DATABASE_URL=postgresql+psycopg://surfacewatch:REPLACE_PASSWORD@localhost:5432/surfacewatch
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Private/loopback ranges require explicit permission. Public addresses are allowed.
# This subnet belongs to the included isolated Docker demo lab.
ALLOWED_TARGET_CIDRS=172.30.0.0/24
MAX_TARGET_ADDRESSES=8
SCAN_TIMEOUT=180
TLS_TIMEOUT=5
REMOVAL_CONFIRMATIONS=2
TLS_WARNING_DAYS=30
TLS_SECOND_WARNING_DAYS=14
TLS_CRITICAL_DAYS=7
SESSION_HOURS=8
WORKER_POLL_SECONDS=3
# Credentials stay in this environment file, never in the browser/database rule.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=surfacewatch@localhost
SMTP_STARTTLS=true
SMTP_ALLOW_PLAINTEXT=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
